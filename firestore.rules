rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    // Şimdilik tüm authenticated userlar admin sayılıyor
    // İleride spesifik email veya custom claim eklenebilir
    function isAdmin() {
      return isAuthenticated();
      // Gelecekte: return isAuthenticated() && request.auth.token.admin == true;
      // Veya: return isAuthenticated() && request.auth.token.email == "admin@avdurdumehmetsen.com";
    }
    
    // Lawyer Info Collection
    match /lawyer-info/{document} {
      // Herkes okuyabilir (public bilgi)
      allow read: if true;
      
      // Sadece admin yazabilir/güncelleyebilir
      allow write: if isAdmin();
    }
    
    // Articles Collection
    match /articles/{article} {
      // Yayındaki makaleleri herkes okuyabilir
      allow read: if resource.data.published == true;
      
      // Admin tüm makaleleri okuyabilir (taslaklar dahil)
      allow read: if isAdmin();
      
      // Sadece admin makale ekleyebilir, güncelleyebilir, silebilir
      allow create, update, delete: if isAdmin();
    }
  }
}

