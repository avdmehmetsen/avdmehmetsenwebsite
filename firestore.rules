rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    // Şimdilik tüm authenticated userlar admin sayılıyor
    // İleride spesifik email veya custom claim eklenebilir
    function isAdmin() {
      return isAuthenticated();
      // Gelecekte: return isAuthenticated() && request.auth.token.admin == true;
      // Veya: return isAuthenticated() && request.auth.token.email == "admin@avdurdumehmetsen.com";
    }
    
    // Lawyer Info Collection
    match /lawyer-info/{document} {
      // Herkes okuyabilir (public bilgi)
      allow read: if true;
      
      // Sadece admin yazabilir/güncelleyebilir
      allow write: if isAdmin();
    }
    
    // Articles Collection
    match /articles/{article} {
      // Get (tekil document okuma): Published veya admin
      allow get: if resource.data.published == true || isAdmin();
      
      // List (collection query): Herkes (published filtresi kod tarafında yapılıyor)
      allow list: if true;
      
      // Yazma izni: Sadece admin makale ekleyebilir, güncelleyebilir, silebilir
      allow create, update, delete: if isAdmin();
    }
    
    // Announcements Collection
    match /announcements/{announcement} {
      // Get (tekil document okuma): Published veya admin
      allow get: if resource.data.published == true || isAdmin();
      
      // List (collection query): Herkes (published filtresi kod tarafında yapılıyor)
      allow list: if true;
      
      // Yazma izni: Sadece admin duyuru ekleyebilir, güncelleyebilir, silebilir
      allow create, update, delete: if isAdmin();
    }
    
    // Contacts Collection
    match /contacts/{contact} {
      // Okuma: Sadece admin okuyabilir
      allow read: if isAdmin();
      
      // Yazma: Herkes mesaj gönderebilir (create), sadece admin güncelleyebilir/silebilir
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // Contact Info Collection (Telefon, Email, Adres, Maps)
    match /contactInfo/{document} {
      // Herkes okuyabilir (public bilgi - sitede gösteriliyor)
      allow read: if true;
      
      // Sadece admin yazabilir/güncelleyebilir
      allow write: if isAdmin();
    }
    
    // Site Settings Collection (Bakım Modu, vb.)
    match /siteSettings/{document} {
      // Herkes okuyabilir (bakım modu kontrolü için gerekli)
      allow read: if true;
      
      // Sadece admin yazabilir/güncelleyebilir
      allow write: if isAdmin();
    }
  }
}

